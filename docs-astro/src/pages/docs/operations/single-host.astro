---
import DocsLayout from '../../../layouts/DocsLayout.astro';
const sidebar = [
  { title: 'Operations Overview', href: '/docs/operations' },
  { title: 'Two-Host', href: '/docs/operations/two-host' },
  { title: 'Single-Host', href: '/docs/operations/single-host', active: true },
  { title: 'Hardening', href: '/docs/operations/hardening' },
  { title: 'Runbooks', href: '/docs/operations/runbooks' },
];
const toc = [
  { id: 'ids', text: 'Dashboard IDs', level: 2 },
  { id: 'context', text: 'SIEM Single-Host Context', level: 2 },
  { id: 'notes', text: 'Single-Host Notes', level: 2 },
