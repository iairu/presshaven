---
import DocsLayout from '../../../layouts/DocsLayout.astro';
const sidebar = [
  { title: 'Detection', href: '/docs/detection' },
  { title: 'Observability', href: '/docs/observability' },
  { title: 'Operations', href: '/docs/operations' },
  { title: 'Testing', href: '/docs/testing' },
  { title: 'Reference', href: '/docs/reference' },
  { title: 'Architecture', href: '/docs/architecture' },
  { title: 'Honeypot Engine', href: '/docs/engine' },
  { title: 'Getting Started', href: '/docs/getting-started', active: true },
];
const toc = [
  { id: 'overview', text: 'Getting Started', level: 2 },
];
---
<DocsLayout title="Getting Started" description="Installation, quickstart, and setup guides" section="Getting Started" sidebar={sidebar} toc={toc}>
  <h2 id="overview">Getting Started</h2>
  <p>Bring the stack up, fire your first attack, and watch it get diverted — in about five minutes.</p>
  <ul>
    <li><strong>Installation & Setup</strong> — Prerequisites, Docker Compose, environment variables.</li>
    <li><strong>Quickstart</strong> — First attack in 5 minutes.</li>
    <li><strong>The Dashboard</strong> — Desktop control panel overview.</li>
    <li><strong>Command Cheat Sheet</strong> — Common commands and operations.</li>
  </ul>
  <p>Content derived from the old mkdocs documentation in <code>docs-mkdocs-old/docs/getting-started/</code>.</p>
</DocsLayout>
