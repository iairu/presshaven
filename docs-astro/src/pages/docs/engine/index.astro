const sidebar = [
  { title: 'Documentation Home', href: '/docs' },
  { title: 'Honeypot Engine', href: '/docs/engine', active: true },
  { title: 'Honeypot Layers', href: '/docs/engine/layers' },
];
const toc = [
  { id: 'layers', text: 'Engine Layers', level: 2 },
  { id: 'pools', text: 'Pool Lifecycle', level: 2 },
  { id: 'seeding', text: 'Seeding the Storefront', level: 2 },
  { id: 'sync', text: 'Content Replication', level: 2 },
