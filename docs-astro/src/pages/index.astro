<script>
  const dash = document.querySelector('[data-dash]');
  if (dash) {
    const crumb = dash.querySelector('[data-dash-crumb]');
    const title = dash.querySelector('[data-dash-title]');
    const desc = dash.querySelector('[data-dash-desc]');
    const widgets = dash.querySelector('[data-dash-widgets]');
    const widgetTiles = widgets ? Array.from(widgets.querySelectorAll('.home-dash__widget')) : [];
    const items = Array.from(dash.querySelectorAll('[data-page]'));
    const toggles = Array.from(dash.querySelectorAll('[data-overflow-toggle]'));

    function closeOverflow(except) {
      toggles.forEach((btn) => {
        if (btn === except) return;
        btn.setAttribute('aria-expanded', 'false');
        const panel = btn.nextElementSibling;
        if (panel) panel.hidden = true;
      });
    }

    items.forEach((btn) => {
      btn.addEventListener('click', () => {
        items.forEach((i) => i.classList.remove('is-active'));
        btn.classList.add('is-active');
        if (crumb) crumb.textContent = btn.dataset.group || '';
        if (title) title.textContent = btn.dataset.label || '';
        if (desc) desc.textContent = btn.dataset.summary || '';
        try {
          const pairs = JSON.parse(btn.dataset.widgets || '[]');
          widgetTiles.forEach((tile, i) => {
            const pair = pairs[i];
            if (!pair) return;
            const label = tile.querySelector('.label');
            const value = tile.querySelector('.value');
            if (label) label.textContent = pair[0];
            if (value) value.textContent = pair[1];
          });
        } catch {}
        closeOverflow(null);
      });
    });

    toggles.forEach((btn) => {
      btn.addEventListener('click', (event) => {
        event.stopPropagation();
        const panel = btn.nextElementSibling;
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        closeOverflow(btn);
        if (panel) panel.hidden = isOpen;
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
    });

    document.addEventListener('click', (event) => {
      if (!dash.contains(event.target)) closeOverflow(null);
    });
  }
</script>
