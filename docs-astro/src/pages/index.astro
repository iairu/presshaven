---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Knowledge Hub" description="Honeypot IDS System — an integrated knowledge hub with interactive demos">
  <!-- Hero Section -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-accent-green/5 via-transparent to-transparent pointer-events-none"></div>
    <div class="container mx-auto px-6 py-14 text-center relative">
      <div class="inline-flex items-center gap-2 bg-bg-tertiary/80 border border-border-accent rounded-full px-4 py-1.5 mb-6 text-sm text-text-secondary">
        <span class="w-2 h-2 bg-accent-green rounded-full animate-pulse"></span>
        FIIT STU Master's Thesis Project
      </div>
      <h1 class="text-5xl md:text-6xl font-extrabold mb-6 leading-tight">
        <span class="hero-gradient">Honeypot IDS</span>
        <br />
        <span class="text-text-primary">Knowledge Hub</span>
      </h1>
      <p class="text-xl text-text-secondary max-w-3xl mx-auto mb-8 leading-relaxed">
        A high-interaction deception platform that <span class="text-text-primary font-semibold">captures, scores, and isolates</span> attackers in real time. Explore the architecture, dive into the detection pipeline,
        run interactive simulations, and understand every function.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/docs/detection" class="btn-sheared text-base px-6 py-3">Detection Docs</a>
        <a href="/docs/observability" class="btn-sheared secondary text-base px-6 py-3">Observability</a>
        <a href="/docs/operations" class="btn-sheared secondary text-base px-6 py-3">Operations</a>
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="container mx-auto px-6 py-6">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      <div class="stat">
        <div class="num">14+</div>
        <div class="label">Seeded CVEs</div>
      </div>
      <div class="stat">
        <div class="num">70+</div>
        <div class="label">Suricata SIDs</div>
      </div>
      <div class="stat">
        <div class="num">11</div>
        <div class="label">Routing Stages</div>
      </div>
      <div class="stat">
        <div class="num">18</div>
        <div class="label">Unit Tests</div>
      </div>
      <div class="stat">
        <div class="num">7</div>
        <div class="label">Dashboards</div>
      </div>
      <div class="stat">
        <div class="num">14</div>
        <div class="label">Lua Modules</div>
      </div>
    </div>
  </section>

  <!-- What This System Does -->
  <section class="container mx-auto px-6 py-6">
    <div class="max-w-4xl">
      <h2 class="text-3xl font-bold mb-6 text-text-primary">What This System Does</h2>
      <p class="text-lg text-text-secondary leading-relaxed mb-6">
        A WordPress/WooCommerce storefront that looks and behaves like a real shop — but sits behind an
        OpenResty (Nginx + Lua) reverse proxy that scores every request in real time and transparently
        diverts suspicious sessions into isolated, full-fidelity honeypot clones. Legitimate customers
        never notice; attackers get a convincing, exploitable target while every move is recorded.
      </p>
    </div>
  </section>

  <!-- Quick Navigation -->
  <section class="container mx-auto px-6 py-6">
    <h2 class="text-3xl font-bold mb-6 text-text-primary">Quick Navigation</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <a href="/docs/detection" class="card card-hover no-underline">
        <h3 class="text-lg font-semibold mb-2">Detection</h3>
        <p class="text-text-secondary text-sm">Multi-layered detection pipeline: URI patterns, CVE matching, Suricata IDS, IP reputation.</p>
        <div class="meta mt-3">5 pages · 14 modules</div>
      </a>
      <a href="/docs/observability" class="card card-hover no-underline">
        <h3 class="text-lg font-semibold mb-2">Observability</h3>
        <p class="text-text-secondary text-sm">Vector → Elasticsearch → Kibana. 7 dashboards + pattern report timeline.</p>
        <div class="meta mt-3">3 pages · 7 dashboards</div>
      </a>
      <a href="/docs/operations" class="card card-hover no-underline">
        <h3 class="text-lg font-semibold mb-2">Operations</h3>
        <p class="text-text-secondary text-sm">Two-host and single-host deployment, production hardening, troubleshooting runbooks.</p>
        <div class="meta mt-3">5 pages · 2 topologies</div>
      </a>
      <a href="/docs/testing" class="card card-hover no-underline">
        <h3 class="text-lg font-semibold mb-2">Testing</h3>
        <p class="text-text-secondary text-sm">18 pure-Lua unit test files, dashboard validation, blind pentest protocol.</p>
        <div class="meta mt-3">2 pages · 18 tests</div>
      </a>
      <a href="/docs/reference" class="card card-hover no-underline">
        <h3 class="text-lg font-semibold mb-2">Reference</h3>
        <p class="text-text-secondary text-sm">Glossary, known issues, roadmap, changelog, literature, function reference.</p>
        <div class="meta mt-3">6 pages</div>
      </a>
      <a href="/sim" class="card card-hover no-underline">
        <h3 class="text-lg font-semibold mb-2">Simulator</h3>
        <p class="text-text-secondary text-sm">Interactive request scoring simulator with real-time results.</p>
        <div class="meta mt-3">Live interactive</div>
      </a>
      <a href="/demo" class="card card-hover no-underline">
        <h3 class="text-lg font-semibold mb-2">Live Demo</h3>
        <p class="text-text-secondary text-sm">Live honeypot demonstration with attack scenarios.</p>
        <div class="meta mt-3">5 scenarios</div>
      </a>
      <a href="/docs/architecture" class="card card-hover no-underline">
        <h3 class="text-lg font-semibold mb-2">Architecture</h3>
        <p class="text-text-secondary text-sm">Request pipeline, two-host split, Lua module architecture, pooling system.</p>
        <div class="meta mt-3">Full reference</div>
      </a>
    </div>
  </section>

  <!-- Architecture Overview -->
  <section class="container mx-auto px-6 py-6">
    <h2 class="text-3xl font-bold mb-6 text-text-primary">Architecture Overview</h2>
    <div class="demo-box">
      <h3>Request Pipeline</h3>
      <pre><code>Client Request → Nginx access_by_lua_block → pattern_analyzer.analyze_request()
  → router.decide_route() (11 stages) → pool_router.get_or_assign_pool()
  → session_handler.update_session() → Redis session_store
  → Suricata eve.json → init_worker.lua → threat_intel shared dict
  → abuseipdb_client.report_ip_async() → AbuseIPDB</code></pre>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
      <div class="admonition info">
        <div class="admonition-title">Edge Host</div>
        <p>Reverse proxy, WordPress (production + honeypot pools), Redis, Suricata, local Vector shipper. Runs the Nginx Lua pipeline.</p>
      </div>
      <div class="admonition tip">
        <div class="admonition-title">SIEM Host</div>
        <p>Log storage/analysis: Elasticsearch, Kibana, Vector aggregator. Connected via mTLS outbound-only channel.</p>
      </div>
    </div>
  </section>

  <!-- Honest Assessment -->
  <section class="container mx-auto px-6 py-6">
    <h2 class="text-3xl font-bold mb-6 text-text-primary">Honest Assessment</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="admonition tip">
        <div class="admonition-title">Strengths</div>
        <ul class="space-y-1 text-sm">
          <li>Multi-layered detection (11+ stages)</li>
          <li>Explainable, auditable scoring with WSTG mappings</li>
          <li>Per-attacker isolation via elastic pools</li>
          <li>No tarpit — identical proxy latency</li>
          <li>Privacy-preserving GDPR identity</li>
          <li>Honeytoken injection for high-confidence signals</li>
          <li>18 unit test files (pure/adapter split)</li>
          <li>Severity-graded Suricata integration</li>
        </ul>
      </div>
      <div class="admonition warning">
        <div class="admonition-title">Limitations</div>
        <ul class="space-y-1 text-sm">
          <li>Same-host Suricata testing gap</li>
          <li>Decay system complexity (4 params)</li>
          <li>Honeytoken coverage (only 5 types)</li>
          <li>No ML (rule-based only)</li>
          <li>Redis single point of failure</li>
          <li>Pool scaling limits</li>
          <li>No end-to-end integration tests</li>
          <li>Dashboard drift risk</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>