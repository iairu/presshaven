---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const github = 'https://github.com/iairu/honeypot-ids';

const stats = [
  { num: '13', label: 'Seeded CVEs' },
  { num: '70+', label: 'Suricata SIDs' },
  { num: '12', label: 'Routing Stages' },
  { num: '17', label: 'Pure Lua Modules' },
  { num: '23', label: 'Unit Test Files' },
  { num: '6', label: 'Kibana Dashboards' },
];

// Mirrors the real dashboard's nav structure 1:1 (dashboard/ui/main_window.py
// NAV_GROUPS / NAV_OVERFLOW / PAGE_LABELS) and page summaries
// (dashboard/core/learning.py PAGE_GUIDES) — nothing here is invented.
// widgets are small qualitative capability tags (not invented live metrics) —
// each pulled from the page's real purpose above, plus a few verified counts
// already used elsewhere on this page (13 CVEs, 70+ SIDs, 6 dashboards, etc).
const dashNav = [
  {
    group: 'Overview',
    items: [
      { id: 'overview', label: 'Overview', icon: 'gauge', summary: "Operations landing page: current risk score, both stacks' health, and a live feed of notable security events.", widgets: [['Risk score', 'Live'], ['Stacks', '2 tracked'], ['Events', 'Live feed']] },
    ],
    overflow: [],
  },
  {
    group: 'Monitor',
    items: [
      { id: 'live_events', label: 'Live Events', icon: 'activity', summary: "Real-time stream of the proxy's detection decisions, filterable and exportable, without needing the SIEM.", widgets: [['Stream', 'Real-time'], ['Filter', 'Yes'], ['Export', 'CSV/JSON']] },
      { id: 'health', label: 'Global Visualization', icon: 'sitemap', summary: 'Topology map of every workload with live health, enforcement path and honeypot pool status.', widgets: [['View', 'Topology'], ['Health', 'Live'], ['Pools', 'Shown']] },
      { id: 'kibana', label: 'SIEM Analytics', icon: 'chart', summary: 'SIEM dashboards for flows, alerts and security events, correlated across both stacks.', widgets: [['Dashboards', '6'], ['Stacks', 'Correlated'], ['Scope', 'Flows + alerts']] },
    ],
    overflow: [
      { id: 'pipeline', label: 'Log Pipeline', icon: 'route', summary: "Is the edge shipper really delivering logs to the SIEM? Shipping config, shipper, log errors and aggregator in one check.", widgets: [['Transport', 'mTLS'], ['Shipper', 'Vector'], ['Checks', 'Config + errors']] },
      { id: 'resources', label: 'Workload Telemetry', icon: 'cpu', summary: 'Per-workload CPU, memory and network telemetry, annotated with attack-simulation markers.', widgets: [['Metrics', 'CPU/mem/net'], ['Scope', 'Per workload'], ['Markers', 'Attack sim']] },
      { id: 'log_search', label: 'Forensics Analysis', icon: 'search', summary: 'Forensic search across raw logs from every workload.', widgets: [['Scope', 'All workloads'], ['Mode', 'Raw search'], ['Range', 'Selectable']] },
    ],
  },
  {
    group: 'Threat Operations',
    items: [
      { id: 'patterns', label: 'Attack Simulation', icon: 'zap', summary: 'Replay real WordPress CVE patterns against the edge and observe detection, scoring and diversion.', widgets: [['Library', '13 CVEs'], ['Replay', 'One click'], ['Outcome', 'Scored live']] },
      { id: 'sessions', label: 'Attacker Sessions', icon: 'fingerprint', summary: "Per-session drill-down: who each visitor is, how their risk score climbed, and where they were diverted.", widgets: [['Scope', 'Per session'], ['Score', 'Trend shown'], ['Routing', 'Divert trace']] },
      { id: 'suricata', label: 'Network IDS (Suricata)', icon: 'shieldAlert', summary: 'Network IDS view: recent Suricata alerts, top signatures and sources, and the rule set with per-rule switches.', widgets: [['Rules', '70+ SIDs'], ['Alerts', 'Live feed'], ['Toggles', 'Per rule']] },
      { id: 'detection', label: 'Detection Policy', icon: 'crosshair', summary: 'Tune how evidence builds and fades: score decay, IP-reputation weight and shared-address handling.', widgets: [['Decay', 'Tunable'], ['IP rep', 'Weighted'], ['Shared IP', 'Configurable']] },
    ],
    overflow: [
      { id: 'pattern_database', label: 'Pattern Database', icon: 'clipboard', summary: 'Browse every detection pattern in one place: CVEs, generic signatures, upload and header rules, scanner tools and Suricata SIDs, with provenance and an attack lesson for each.', widgets: [['CVE rules', '13'], ['IDS rules', '70+ SIDs'], ['Provenance', 'Per entry']] },
      { id: 'signature_sim', label: 'Signature Simulation', icon: 'eye', summary: "Watch one browser characteristic become the proxy's consent-gated one-way gdpr_signature, end to end.", widgets: [['Token', 'RSA-OAEP'], ['Signature', 'One-way'], ['Consent', 'Required']] },
      { id: 'pool_scaling', label: 'Pool Scaling', icon: 'layers', summary: 'Standing view of the honeypot pools: count, resource budget, who is on which pool, and why scaling stops.', widgets: [['Pools', 'Static + runtime'], ['Budget', 'Capped'], ['Scaling', 'On demand']] },
      { id: 'pool_test', label: 'Segmentation Validation', icon: 'target', summary: 'Validate per-session segmentation: several isolated user sessions, each diverted to its own honeypot pool.', widgets: [['Sessions', 'Parallel'], ['Pools', 'Isolated'], ['Check', 'Segmentation']] },
      { id: 'redis', label: 'Pool State Store', icon: 'database', summary: "Inspect the proxy's live state store: sessions, risk scores, IP reputation and pool bindings.", widgets: [['Store', 'Live state'], ['Scores', 'Per session'], ['Bindings', 'Pool-mapped']] },
    ],
  },
  {
    group: 'Manage',
    items: [
      { id: 'services', label: 'Workloads', icon: 'server', summary: 'Workload inventory and lifecycle control for the IDS edge and SIEM stacks, with live container logs.', widgets: [['Stacks', 'Edge + SIEM'], ['Control', 'Start/stop'], ['Logs', 'Live tail']] },
      { id: 'settings', label: 'Connectors & Config', icon: 'wrench', summary: 'Target connectors (local or SSH), stack configuration, detection policy values and console preferences.', widgets: [['Connectors', 'Local + SSH'], ['Policy', 'Tunable'], ['Prefs', 'Console-wide']] },
    ],
    overflow: [
      { id: 'certificates', label: 'PKI & Certificates', icon: 'key', summary: 'Issue and rotate the TLS certificates securing the edge proxy and SIEM endpoints.', widgets: [['Scope', 'Edge + SIEM'], ['Rotation', 'On demand'], ['Trust', 'Self-issued']] },
      { id: 'backups', label: 'Backup & Recovery', icon: 'archive', summary: 'Snapshot and restore workload data volumes for incident recovery.', widgets: [['Snapshots', 'On demand'], ['Scope', 'Per workload'], ['Restore', 'Point-in-time']] },
    ],
  },
  {
    group: 'Reporting',
    items: [
      { id: 'learn', label: 'Knowledge Base', icon: 'book', summary: 'Glossary, guided labs and a threat brief for every attack-simulation preset.', widgets: [['Glossary', 'Searchable'], ['Labs', 'Guided'], ['Briefs', 'Per preset']] },
    ],
    overflow: [
      { id: 'extras', label: 'Reporting', icon: 'file', summary: 'Report generation: implementation chapter, architecture overview and pattern / CVE matrix.', widgets: [['Chapters', 'Multi-part'], ['Matrix', 'Pattern/CVE'], ['Export', 'PDF/MD']] },
    ],
  },
];

const navigation = [
  {
    href: '/docs/detection',
    icon: 'radar',
    kicker: '6 pages',
    title: 'Detection',
    description: 'URI and header patterns, CVE signatures, Suricata alerts, IP reputation, escalation-aware decay and a consent-gated device signature — every score explained.',
    meta: '13 CVEs · WSTG mapped',
  },
  {
    href: '/docs/observability',
    icon: 'chart',
    kicker: '3 pages',
    title: 'Observability',
    description: 'Structured security events shipped over mTLS by Vector into Elasticsearch, with six operational Kibana dashboards and an embedded request timeline.',
    meta: '6 dashboards',
  },
  {
    href: '/docs/operations',
    icon: 'wrench',
    kicker: '5 pages',
    title: 'Operations',
    description: 'Two-host and single-host topologies, production hardening, configuration reference and troubleshooting runbooks.',
    meta: '2 topologies',
  },
  {
    href: '/docs/architecture',
    icon: 'layers',
    kicker: 'Deep dive',
    title: 'Architecture',
    description: 'The pure/adapter split, the twelve-stage routing decision, elastic honeypot pools and the GDPR identity path.',
    meta: 'Full reference',
  },
  {
    href: '/docs/testing',
    icon: 'flask',
    kicker: '2 pages',
    title: 'Testing',
    description: 'Twenty-three pure-Lua unit test suites, dashboard validation and the blind penetration-test protocol.',
    meta: '23 test files',
  },
  {
    href: '/docs/reference',
    icon: 'book',
    kicker: '6 pages',
    title: 'Reference',
    description: 'Glossary, known issues and workarounds, roadmap, changelog, primary literature and module tables.',
    meta: 'Glossary · roadmap',
  },
];
---
<Layout title="Home" description="Honeypot IDS System — architecture, detection, observability and operations documentation">
  <!-- ============================================================
       Hero
       ============================================================ -->
  <section class="home-hero">
    <div class="home-hero__bg" aria-hidden="true">
      <svg class="hero-grid" viewBox="0 0 1200 700" preserveAspectRatio="none">
        <defs>
          <radialGradient id="home-hero-fade" cx="50%" cy="28%" r="72%">
            <stop offset="0%" style="stop-color: var(--color-bg-primary); stop-opacity: 0" />
            <stop offset="100%" style="stop-color: var(--color-bg-primary); stop-opacity: 0.92" />
          </radialGradient>
        </defs>
        <path d="M-40 180 Q 300 80 640 190 T 1260 140" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.5" />
        <path d="M-40 300 Q 320 230 660 320 T 1260 260" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.4" />
        <path d="M-40 430 Q 340 380 680 450 T 1260 390" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.32" />
        <path d="M-40 560 Q 360 520 700 580 T 1260 530" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.24" />
        <rect width="1200" height="700" fill="url(#home-hero-fade)" />
      </svg>
      <svg class="hero-radar" viewBox="0 0 400 400" fill="none">
        <circle cx="200" cy="200" r="196" stroke="currentColor" stroke-width="1" opacity="0.3" />
        <circle cx="200" cy="200" r="150" stroke="currentColor" stroke-width="1" stroke-dasharray="2 7" opacity="0.55" />
        <circle cx="200" cy="200" r="104" stroke="currentColor" stroke-width="1" opacity="0.4" />
        <circle cx="200" cy="200" r="58" stroke="currentColor" stroke-width="1" stroke-dasharray="2 5" opacity="0.6" />
        <path d="M200 4v392M4 200h392" stroke="currentColor" stroke-width="1" opacity="0.25" />
        <path d="M200 200L200 4A196 196 0 0 1 369 83Z" fill="currentColor" opacity="0.1" />
        <line x1="200" y1="200" x2="200" y2="4" stroke="currentColor" stroke-width="1.4" opacity="0.8" />
        <circle cx="286" cy="128" r="4" fill="currentColor" />
        <circle cx="138" cy="258" r="3" fill="currentColor" opacity="0.7" />
        <circle cx="252" cy="292" r="2.5" fill="currentColor" opacity="0.5" />
      </svg>
      <div class="hero-glow"></div>
      <svg class="hero-corner hero-corner--tl" viewBox="0 0 100 100" fill="none">
        <path d="M2 40V2h38M2 58V2h56" stroke="currentColor" stroke-width="1.2" />
        <circle cx="2" cy="2" r="2" fill="currentColor" />
      </svg>
      <svg class="hero-corner hero-corner--br" viewBox="0 0 100 100" fill="none">
        <path d="M2 40V2h38M2 58V2h56" stroke="currentColor" stroke-width="1.2" />
        <circle cx="2" cy="2" r="2" fill="currentColor" />
      </svg>
    </div>

      <div class="container home-hero__inner">
        <div class="home-hero__copy">
          <h1>
            <span class="hero-gradient home-hero__title-brand">Honeypot IDS</span>
            <span class="home-hero__title-label">Knowledge Hub</span>
          </h1>
          <p class="home-hero__lead">
            A high-interaction deception platform built around a <strong>WordPress + WooCommerce</strong> shop
            as its target demo application. It <strong>scores every request in real time</strong> and quietly
            diverts suspicious sessions into isolated honeypot clones. Real customers never notice; attackers
            get a convincing storefront while every move is recorded.
          </p>
          <div class="home-cta">
            <a href="/docs/getting-started" class="btn-sheared">
              <Icon name="terminal" class="w-4 h-4" />
              Get started
            </a>
            <a href="/docs/architecture" class="btn-sheared secondary">
              <Icon name="layers" class="w-4 h-4" />
              Architecture
            </a>
            <a href={github} target="_blank" rel="noopener" class="btn-sheared ghost">
              <Icon name="github" class="w-4 h-4" />
              Source
            </a>
          </div>
          <div class="home-chips">
            <span><Icon name="box" class="w-3.5 h-3.5" /> WordPress + WooCommerce</span>
            <span><Icon name="shield" class="w-3.5 h-3.5" /> No tarpit</span>
            <span><Icon name="fingerprint" class="w-3.5 h-3.5" /> Session-bound</span>
            <span><Icon name="lock" class="w-3.5 h-3.5" /> GDPR aware</span>
            <span><Icon name="branch" class="w-3.5 h-3.5" /> Pure / adapter split</span>
          </div>
        </div>

        <div class="home-hero__visual">
          <div class="home-dash" data-dash>
            <div class="home-dash__bar" aria-hidden="true">
              <i></i><i></i><i></i>
              <span class="title">Honeypot IDS · Security Operations Console</span>
            </div>
            <div class="home-dash__body">
              <nav class="home-dash__nav" aria-label="Dashboard navigation (interactive preview)">
                {dashNav.map((section) => (
                  <div class="home-dash__group">
                    <div class="home-dash__group-head">
                      <p class="home-dash__group-label">{section.group}</p>
                      {section.overflow.length > 0 && (
                        <div class="home-dash__more">
                          <button
                            type="button"
                            class="home-dash__more-toggle"
                            data-overflow-toggle
                            aria-haspopup="true"
                            aria-expanded="false"
                            aria-label={`More ${section.group} pages`}
                          >
                            <span aria-hidden="true">⋮</span>
                          </button>
                          <div class="home-dash__overflow" hidden>
                            {section.overflow.map((item) => (
                              <button
                                type="button"
                                class="home-dash__item"
                                data-page={item.id}
                                data-group={section.group}
                                data-label={item.label}
                                data-summary={item.summary}
                                data-widgets={JSON.stringify(item.widgets)}
                              >
                                <Icon name={item.icon} class="w-3.5 h-3.5" />
                                <span>{item.label}</span>
                              </button>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                    {section.items.map((item) => (
                      <button
                        type="button"
                        class={`home-dash__item${item.id === 'overview' ? ' is-active' : ''}`}
                        data-page={item.id}
                        data-group={section.group}
                        data-label={item.label}
                        data-summary={item.summary}
                        data-widgets={JSON.stringify(item.widgets)}
                      >
                        <Icon name={item.icon} class="w-3.5 h-3.5" />
                        <span>{item.label}</span>
                      </button>
                    ))}
                  </div>
                ))}
              </nav>

              <div class="home-dash__pane">
                <p class="home-dash__crumb" data-dash-crumb>Overview</p>
                <h3 class="home-dash__title" data-dash-title>Overview</h3>
                <p class="home-dash__desc" data-dash-desc>Operations landing page: current risk score, both stacks' health, and a live feed of notable security events.</p>
                <div class="home-dash__widgets" data-dash-widgets>
                  <div class="home-dash__widget"><p class="label">Risk score</p><p class="value">Live</p></div>
                  <div class="home-dash__widget"><p class="label">Stacks</p><p class="value">2 tracked</p></div>
                  <div class="home-dash__widget"><p class="label">Events</p><p class="value">Live feed</p></div>
                </div>
              </div>
            </div>

            <div class="home-dash__foot">
              <span><span class="ok">●</span> 22 pages</span>
              <span>5 groups · click a page to explore</span>
            </div>
          </div>
        </div>
      </div>
  </section>

  <!-- ============================================================
       Stats
       ============================================================ -->
  <section class="home-stats" aria-label="System at a glance">
    <div class="container">
      <div class="home-stats__label">
        <span>System at a glance</span>
        <span class="line"></span>
        <span>last revision · v2.0</span>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6">
        {stats.map(stat => (
          <div class="stat">
            <div class="num">{stat.num}</div>
            <div class="label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       What this system does
       ============================================================ -->
  <section class="home-section">
    <div class="home-section__bg" aria-hidden="true">
      <svg style="left: -6rem; bottom: -7rem; width: 24rem; height: 24rem; opacity: 0.35;" viewBox="0 0 400 400" fill="none">
        <circle cx="200" cy="200" r="190" stroke="currentColor" stroke-width="1" stroke-dasharray="2 8" />
        <circle cx="200" cy="200" r="130" stroke="currentColor" stroke-width="1" />
        <path d="M200 10v380M10 200h380" stroke="currentColor" stroke-width="0.8" opacity="0.6" />
      </svg>
    </div>
    <div class="container home-section__inner">
      <div class="home-split">
        <div class="home-copy">
          <div class="home-eyebrow home-eyebrow--section">The idea</div>
          <h2 style="font-size: clamp(1.8rem, 3.4vw, 2.65rem); letter-spacing: -0.035em; margin: 0.8rem 0 1rem;">
            A real storefront that quietly becomes a trap.
          </h2>
          <p>
            The target demo application is a full <strong>WordPress + WooCommerce</strong> storefront — a
            coffee eshop with real products and carts — and both honeypot layers are built for and around it.
            In front of it sits an OpenResty reverse proxy that scores every non-static request in Lua: URI and
            header patterns, seeded WordPress and WooCommerce CVE signatures, request rate, session history,
            network IDS alerts and IP reputation.
          </p>
          <p>
            Legitimate traffic continues to production. Once a session crosses the threshold it is bound to
            its own honeypot pool — a complete clone of the WooCommerce shop — and stays there. Carts follow
            the session, so the diversion is invisible and nothing about normal browsing changes.
          </p>
          <ul class="home-points">
            <li><Icon name="check" class="w-4 h-4" /><span><strong>Session-bound, not IP-bound.</strong> A signed cookie plus passive fingerprint recovery keeps the experience stable.</span></li>
            <li><Icon name="check" class="w-4 h-4" /><span><strong>Elastic pools.</strong> One isolated shop and database per session, cloned from a pre-built template and recycled when idle.</span></li>
            <li><Icon name="check" class="w-4 h-4" /><span><strong>Full telemetry.</strong> Security events and Suricata alerts flow through Vector into Elasticsearch and Kibana.</span></li>
          </ul>
        </div>

        <div class="home-split__media">
          <figure class="home-diagram">
            <svg viewBox="0 0 560 360" role="img" aria-label="Request lifecycle: client to reverse proxy, then production shop or honeypot pool, with Redis and Suricata on the edge">
              <rect class="diagram-frame" x="0.5" y="0.5" width="559" height="359" />
              <text class="diagram-text--sm" x="18" y="24">REQUEST LIFECYCLE</text>
              <text class="diagram-text--sm diagram-text--accent" x="542" y="24" text-anchor="end">EDGE HOST</text>
              <line class="diagram-line" x1="16" y1="34" x2="544" y2="34" />

              <rect class="diagram-node" x="24" y="140" width="88" height="50" />
              <text class="diagram-text" x="68" y="161" text-anchor="middle">CLIENT</text>
              <text class="diagram-text--sm" x="68" y="175" text-anchor="middle">HTTP</text>

              <rect class="diagram-node diagram-node--accent" x="148" y="124" width="116" height="82" />
              <text class="diagram-text diagram-text--accent" x="206" y="148" text-anchor="middle">OPENRESTY</text>
              <text class="diagram-text--sm" x="206" y="163" text-anchor="middle">analyze_request()</text>
              <text class="diagram-text--sm" x="206" y="175" text-anchor="middle">decide_route()</text>
              <text class="diagram-text--sm" x="206" y="187" text-anchor="middle">12 stages</text>

              <path class="diagram-arrow" d="M264 165H300" />
              <path class="diagram-line--accent" d="M300 165V96H350" />
              <path class="diagram-line--accent" d="M300 165V234H350" />
              <path class="diagram-arrowhead" d="M350 96l-8-4v8z" />
              <path class="diagram-arrowhead" d="M350 234l-8-4v8z" />
              <path class="diagram-arrowhead" d="M300 165l-7-4v8z" />

              <rect class="diagram-node" x="354" y="74" width="182" height="44" />
              <text class="diagram-text" x="368" y="92">PRODUCTION SHOP</text>
              <text class="diagram-text--sm" x="368" y="106">legitimate traffic</text>

              <rect class="diagram-node" x="354" y="212" width="182" height="44" />
              <text class="diagram-text diagram-text--accent" x="368" y="230">HONEYPOT POOL N</text>
              <text class="diagram-text--sm" x="368" y="244">isolated shop + database</text>

              <rect class="diagram-panel" x="24" y="236" width="88" height="44" />
              <text class="diagram-text" x="68" y="253" text-anchor="middle">SURICATA</text>
              <text class="diagram-text--sm" x="68" y="267" text-anchor="middle">eve.json</text>
              <path class="diagram-line--dash-accent" d="M112 258H148" />
              <path class="diagram-arrowhead" d="M148 258l-7-4v8z" />

              <rect class="diagram-panel" x="148" y="256" width="116" height="40" />
              <text class="diagram-text" x="206" y="273" text-anchor="middle">REDIS</text>
              <text class="diagram-text--sm" x="206" y="286" text-anchor="middle">session + pools</text>
              <path class="diagram-line--dash" d="M206 236V256" />

              <path class="diagram-line--dash" d="M206 300V330H536" />
              <text class="diagram-text--sm diagram-text--accent" x="282" y="344">VECTOR → ELASTICSEARCH → KIBANA</text>
              <circle class="diagram-dot" cx="206" cy="300" r="2.4" />
            </svg>
            <figcaption>
              <span>Scoring and diversion stay in the request path</span>
              <em>no tarpit</em>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       Quick navigation
       ============================================================ -->
  <section class="home-section home-section--alt">
    <div class="home-section__bg" aria-hidden="true">
      <svg style="right: -8rem; top: 50%; transform: translateY(-50%); width: 30rem; height: 30rem; opacity: 0.3;" viewBox="0 0 400 400" fill="none">
        <circle cx="200" cy="200" r="196" stroke="currentColor" />
        <circle cx="200" cy="200" r="150" stroke="currentColor" stroke-dasharray="3 7" />
        <circle cx="200" cy="200" r="104" stroke="currentColor" />
        <circle cx="200" cy="200" r="58" stroke="currentColor" stroke-dasharray="3 7" />
        <path d="M4 200h392M200 4v392" stroke="currentColor" opacity="0.5" />
      </svg>
    </div>
    <div class="container home-section__inner">
      <div class="home-head home-head--center">
        <div class="home-eyebrow home-eyebrow--section">Documentation map</div>
        <h2>Everything, one layer at a time.</h2>
        <p>Start at the beginning or jump straight into the layer you care about. Every page is written against the actual Lua modules and deployment files in the repository.</p>
      </div>
      <div class="home-nav-grid">
        {navigation.map(item => (
          <a href={item.href} class="card card-hover no-underline home-nav-card">
            <span class="card-icon"><Icon name={item.icon} class="w-5 h-5" /></span>
            <span class="card-kicker">{item.kicker}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <span class="card-foot">
              <span>{item.meta}</span>
              <span class="go">Open <Icon name="arrow" class="w-3.5 h-3.5" /></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       Architecture
       ============================================================ -->
  <section class="home-section">
    <div class="home-section__bg" aria-hidden="true">
