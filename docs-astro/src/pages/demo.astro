---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Live Demo" description="Live honeypot demonstration">
  <div class="container">
    <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">🔬 Live Demo</h1>
    <p style="color: var(--muted); margin-bottom: 2rem;">
      Interactive demonstration of the honeypot detection and routing pipeline.
      Watch requests get scored and routed in real time.
    </p>

    <div class="demo-box">
      <h3>Request Flow Visualization</h3>
      <div id="flow" style="font-family: monospace; font-size: 0.9rem; line-height: 2; margin: 1rem 0;">
        <div>1. Client sends request → Nginx reverse proxy</div>
        <div>2. <code>pattern_analyzer.analyze_request()</code> scores the request</div>
        <div>3. <code>router.decide_route()</code> evaluates 11 stages</div>
        <div>4. <code>pool_router.get_or_assign_pool()</code> assigns honeypot pool (if diverted)</div>
        <div>5. <code>session_handler.update_session()</code> persists state to Redis</div>
        <div>6. Response served from production or honeypot backend</div>
      </div>
    </div>

    <div class="demo-box">
      <h3>Try an Attack</h3>
      <p style="color: var(--muted); margin-bottom: 1rem;">
        Click a button to simulate an attack request and see the detection pipeline in action.
      </p>
      <button class="btn" onclick="simulate('sqli')">SQL Injection</button>
      <button class="btn" onclick="simulate('xss')">XSS Payload</button>
      <button class="btn" onclick="simulate('cve')">CVE Exploit</button>
      <button class="btn" onclick="simulate('scanner')">Scanner UA</button>
      <button class="btn" onclick="simulate('clean')">Clean Request</button>
      <div id="demo-output" style="margin-top: 1rem;"></div>
    </div>

    <div class="section">
      <h2>📊 Detection Pipeline Stages</h2>
      <table>
        <tr><th>Stage</th><th>Condition</th><th>Route</th></tr>
        <tr><td>1</td><td>Static asset</td><td>Production</td></tr>
        <tr><td>1b</td><td>install.php on uninstalled WordPress</td><td>Production</td></tr>
        <tr><td>2</td><td>Session already honeypot_bound</td><td>Honeypot (sticky)</td></tr>
        <tr><td>3</td><td>Risk score ≥ 80</td><td>Honeypot</td></tr>
        <tr><td>4</td><td>CVE pattern matched</td><td>Honeypot</td></tr>
        <tr><td>5</td><td>Vulnerable plugin URI</td><td>Honeypot</td></tr>
        <tr><td>6</td><td>Bad IP reputation (>50)</td><td>Honeypot</td></tr>
        <tr><td>7</td><td>Multiple admin attempts (≥3)</td><td>Honeypot</td></tr>
        <tr><td>8</td><td>Accumulated suspicious (≥5)</td><td>Honeypot</td></tr>
        <tr><td>9</td><td>Rapid automation (score ≥ 40)</td><td>Honeypot</td></tr>
        <tr><td>10</td><td>Suspicious file upload</td><td>Honeypot</td></tr>
        <tr><td>11</td><td>Default</td><td>Production</td></tr>
      </table>
    </div>

    <script>
      const scenarios = {
        sqli: { uri: "/?id=1' OR 1=1--", ua: "sqlmap/1.7", args: "id=1' OR 1=1--", ip: "198.51.100.1", score: 95, patterns: ["sql_or_condition", "flagged_ua_sqlmap"], route: "honeypot" },
        xss: { uri: "/search?q=\x3cscript\x3ealert(1)\x3c/script\x3e", ua: "Mozilla/5.0", args: "q=\x3cscript\x3ealert(1)\x3c/script\x3e", ip: "198.51.100.2", score: 45, patterns: ["xss_script", "xss_alert"], route: "production" },
        cve: { uri: "/wp-json/wp/v2/users?rest_route=/wp/v2/users", ua: "python-requests/2.28", args: "X-WCPAY-PLATFORM-CHECKOUT-USER: 1", ip: "198.51.100.3", score: 90, patterns: ["CVE-2023-28121", "wp_user_enumeration"], route: "honeypot" },
        scanner: { uri: "/wp-admin/", ua: "Nikto/2.1.6", args: "", ip: "198.51.100.4", score: 90, patterns: ["flagged_ua_nikto", "admin_scan"], route: "honeypot" },
        clean: { uri: "/products/woo-tshirt", ua: "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/120.0", args: "", ip: "203.0.113.1", score: 0, patterns: [], route: "production" },
      };

      function simulate(type) {
        const s = scenarios[type];
        const out = document.getElementById('demo-output');
        const suspicious = s.score >= 80;
        out.innerHTML = `
          <div style="margin-top: 1rem; padding: 1rem; background: var(--bg2); border-radius: 8px;">
            <div style="font-size: 1.5rem; font-weight: 700; color: ${suspicious ? '#ff6584' : '#6c63ff'}; margin-bottom: 0.5rem;">
              ${type.toUpperCase()} → Score: ${s.score}/80 → ${suspicious ? '🚨 HONEYPOT' : '✅ PRODUCTION'}
            </div>
            <p><strong>URI:</strong> <code>${s.uri}</code></p>
            <p><strong>User-Agent:</strong> <code>${s.ua}</code></p>
            <p><strong>IP:</strong> <code>${s.ip}</code></p>
            <p><strong>Patterns:</strong> ${s.patterns.length ? s.patterns.join(', ') : 'none'}</p>
            <p><strong>Routing:</strong> ${suspicious ? 'Diverted to honeypot pool (isolated WordPress clone)' : 'Forwarded to production backend'}</p>
          </div>
        `;
      }
    </script>
  </div>
</Layout>