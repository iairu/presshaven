---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  toc?: { id: string; text: string; level: number }[];
  sidebar?: { title: string; href: string; active?: boolean }[];
  section?: string;
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}
const { title, description, toc = [], sidebar = [], section, prev: prevProp, next: nextProp } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const tabs = [
  { title: 'Getting Started', href: '/docs/getting-started' },
  { title: 'Architecture', href: '/docs/architecture' },
  { title: 'Honeypot Engine', href: '/docs/engine' },
  { title: 'Detection', href: '/docs/detection' },
  { title: 'Observability', href: '/docs/observability' },
  { title: 'Operations', href: '/docs/operations' },
  { title: 'Testing', href: '/docs/testing' },
  { title: 'Reference', href: '/docs/reference' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
const isDocs = path === '/docs' || path.startsWith('/docs/');
const isReference = path === '/reference' || path.startsWith('/reference/');

// Reading order for automatic prev / next footer navigation.
const docsOrder = [
  { title: 'Getting Started', href: '/docs/getting-started' },
  { title: 'Architecture', href: '/docs/architecture' },
  { title: 'Honeypot Engine', href: '/docs/engine' },
  { title: 'Detection Overview', href: '/docs/detection' },
  { title: 'Detection Capabilities', href: '/docs/detection/capabilities' },
  { title: 'Seeded CVEs', href: '/docs/detection/cves' },
  { title: 'Suricata Network IDS', href: '/docs/detection/suricata' },
  { title: 'Advanced Signals', href: '/docs/detection/advanced' },
  { title: 'Observability', href: '/docs/observability' },
  { title: 'SIEM & Log Pipeline', href: '/docs/observability/siem' },
  { title: 'Kibana Dashboards', href: '/docs/observability/kibana' },
  { title: 'Operations', href: '/docs/operations' },
  { title: 'Two-Host Deployment', href: '/docs/operations/two-host' },
  { title: 'Single-Host Deployment', href: '/docs/operations/single-host' },
  { title: 'Hardening', href: '/docs/operations/hardening' },
  { title: 'Runbooks', href: '/docs/operations/runbooks' },
  { title: 'Testing', href: '/docs/testing' },
  { title: 'Blind Pentest', href: '/docs/testing/blind-pentest' },
  { title: 'Reference', href: '/docs/reference' },
  { title: 'Glossary', href: '/docs/reference/glossary' },
  { title: 'Known Issues', href: '/docs/reference/known-issues' },
  { title: 'Roadmap', href: '/docs/reference/roadmap' },
  { title: 'Changelog', href: '/docs/reference/changelog' },
  { title: 'Literature', href: '/docs/reference/literature' },
];
const orderIndex = docsOrder.findIndex(d => d.href === path);
const autoPrev = orderIndex > 0 ? docsOrder[orderIndex - 1] : undefined;
const autoNext = orderIndex >= 0 ? docsOrder[orderIndex + 1] : docsOrder[0];
const prevPage = prevProp ?? (path === '/docs' ? undefined : autoPrev);
const nextPage = nextProp ?? (path === '/docs' ? docsOrder[0] : autoNext);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Honeypot IDS Docs</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-bg-primary text-text-primary font-sans antialiased min-h-screen">
    <!-- Search Modal -->
    <div id="search-modal" class="md-search-modal">
      <div class="md-search-modal__overlay" onclick="closeSearch()"></div>
      <div class="md-search-modal__panel">
        <div class="md-search-modal__input">
          <svg class="w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input id="search-input" type="text" placeholder="Search documentation..." autocomplete="off" />
          <kbd>ESC</kbd>
        </div>
        <div id="search-results" class="md-search-modal__results">
          <div class="md-search-empty">Type to search...</div>
        </div>
      </div>
    </div>

    <!-- Top header: brand + search + primary links -->
    <header class="md-header">
      <a href="/" class="md-header__brand">
        <span class="prompt">&gt;</span> Honeypot IDS
        <span class="version">v2.0</span>
      </a>
      <div class="md-header__search">
        <button type="button" class="md-search__button" onclick="openSearch()" aria-label="Search documentation (Cmd+K)">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <span class="label">Search documentation...</span>
          <kbd>⌘K</kbd>
        </button>
      </div>
      <nav class="md-header__nav" aria-label="Primary">
        <a href="/" class={path === '/' ? 'active' : ''}>Hub</a>
        <a href="/docs" class={isDocs ? 'active' : ''}>Docs</a>
        <a href="/reference" class={isReference ? 'active' : ''}>Reference</a>
        <a href="https://github.com/iairu/honeypot-ids" class="md-header__github" target="_blank" rel="noopener" aria-label="Source repository on GitHub">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 00-3.5 21.8c.6.1.8-.2.8-.5v-2c-3.1.7-3.8-1.3-3.8-1.3-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.1.1 1.7 1.2 1.7 1.2 1 1.7 2.6 1.2 3.2.9.1-.8.4-1.3.7-1.6-2.5-.3-5.1-1.2-5.1-5.5 0-1.2.4-2.2 1.1-3-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 3.1 1.1a10.6 10.6 0 015.6 0c2.2-1.4 3.1-1.1 3.1-1.1.6 1.5.2 2.6.1 2.9.7.8 1.1 1.8 1.1 3 0 4.3-2.6 5.2-5.1 5.5.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5A11.2 11.2 0 0012 .8z"/></svg>
        </a>
      </nav>
    </header>

    <!-- Second header: documentation sections -->
    <nav class="md-tabs" aria-label="Documentation sections">
      <div class="md-tabs__list">
        {tabs.map(tab => (
          <a href={tab.href} class:list={['md-tabs__link', { active: isActive(tab.href) }]}>{tab.title}</a>
        ))}
      </div>
    </nav>

    <div class="md-main">
      <div class="md-main__inner">
        <!-- Primary sidebar -->
        <aside class="md-sidebar md-sidebar--primary">
          <div class="md-nav__title">Navigation</div>
          <nav class="md-nav__list" aria-label="Section navigation">
            {sidebar.map(item => (
              <a href={item.href} class:list={['md-nav__link', { active: item.active }]}>{item.title}</a>
            ))}
          </nav>
          <div class="md-sidebar__meta">
            <div class="label">Tip</div>
            <div class="body">Press ⌘K to search every page of the documentation.</div>
          </div>
        </aside>

        <!-- Content -->
        <main class="md-content">
          <article class="md-content__inner">
            <div class="doc-breadcrumbs">
              <a href="/">Home</a>
              <span class="sep">›</span>
              <a href="/docs">Docs</a>
              {section && section !== 'Docs' && section !== title && <><span class="sep">›</span><span class="current">{section}</span></>}
              <span class="sep">›</span>
              <span>{title}</span>
            </div>

            <header class="doc-header">
              <h1>{title}</h1>
              {description && <p class="doc-description">{description}</p>}
            </header>

            <div class="md-typeset">
              <slot />
            </div>

            {(prevPage || nextPage) && (
              <nav class="md-footer-nav" aria-label="Page navigation">
                {prevPage ? (
                  <a href={prevPage.href} class="btn-sheared secondary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                    <span>
                      <span class="dir">Previous</span>
                      <span class="name">{prevPage.title}</span>
                    </span>
                  </a>
                ) : <div class="spacer"></div>}
                {nextPage ? (
                  <a href={nextPage.href} class="btn-sheared secondary next">
                    <span>
                      <span class="dir">Next</span>
                      <span class="name">{nextPage.title}</span>
                    </span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </a>
                ) : <div class="spacer"></div>}
              </nav>
            )}
          </article>
        </main>

        <!-- Secondary sidebar / TOC -->
        <aside class="md-sidebar md-sidebar--secondary">
          <div class="md-nav__title">On this page</div>
          <nav class="md-nav--secondary" id="toc-nav" aria-label="Table of contents">
            {toc.map(item => (
              <a
                href={`#${item.id}`}
                class:list={['md-nav__link', { 'level-3': item.level >= 3 }]}
              >{item.text}</a>
            ))}
          </nav>
        </aside>
      </div>
    </div>

    <footer class="md-footer">
      <div class="md-footer__inner">
        <span>Honeypot IDS System — FIIT STU Master's Thesis Project</span>
        <span>
          <a href="/docs/reference/literature">Literature</a> ·
          <a href="/docs/reference/changelog">Changelog</a> ·
          <a href="https://github.com/iairu/honeypot-ids" target="_blank" rel="noopener">github.com/iairu/honeypot-ids</a>
        </span>
      </div>
    </footer>

    <script>
      const modal = document.getElementById('search-modal');
      const searchInput = document.getElementById('search-input');
      const searchResults = document.getElementById('search-results');

      function openSearch() {
        modal.classList.add('open');
        searchInput.value = '';
        searchResults.innerHTML = '<div class="md-search-empty">Type to search...</div>';
        searchInput.focus();
      }
      function closeSearch() {
        modal.classList.remove('open');
      }
      window.openSearch = openSearch;
      window.closeSearch = closeSearch;
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
        if (e.key === 'Escape') closeSearch();
      });

      const pages = [
        { title: 'Knowledge Hub', url: '/', content: 'honeypot ids detection observability landing' },
        { title: 'Documentation', url: '/docs', content: 'docs index detection observability operations' },
        { title: 'Getting Started', url: '/docs/getting-started', content: 'installation setup quickstart dashboard commands' },
        { title: 'Architecture', url: '/docs/architecture', content: 'request pipeline two-host lua modules services' },
        { title: 'Honeypot Engine', url: '/docs/engine', content: 'wordpress woocommerce pooling seeding backups state' },
        { title: 'Detection Overview', url: '/docs/detection', content: 'detection pipeline scoring CVE suricata' },
        { title: 'Detection Capabilities', url: '/docs/detection/capabilities', content: 'pattern matching CVE suricata scoring function reference' },
        { title: 'Seeded CVEs', url: '/docs/detection/cves', content: 'CVE-2023-28121 CVE-2025-4403 vulnerability' },
        { title: 'Suricata Network IDS', url: '/docs/detection/suricata', content: 'suricata eve.json alerts SID severity' },
        { title: 'Advanced Signals', url: '/docs/detection/advanced', content: 'risk scoring decay policy' },
        { title: 'Observability', url: '/docs/observability', content: 'siem kibana dashboards logs' },
        { title: 'SIEM & Log Pipeline', url: '/docs/observability/siem', content: 'vector elasticsearch kibana logs' },
        { title: 'Kibana Dashboards', url: '/docs/observability/kibana', content: 'dashboards visualizations timeline' },
        { title: 'Operations', url: '/docs/operations', content: 'deployment hardening runbooks' },
        { title: 'Two-Host', url: '/docs/operations/two-host', content: 'two host deployment topology' },
        { title: 'Single-Host', url: '/docs/operations/single-host', content: 'single host deployment' },
        { title: 'Hardening', url: '/docs/operations/hardening', content: 'security production hardening' },
        { title: 'Runbooks', url: '/docs/operations/runbooks', content: 'troubleshooting incident response' },
        { title: 'Testing', url: '/docs/testing', content: 'unit tests blind pentest' },
        { title: 'Blind Pentest', url: '/docs/testing/blind-pentest', content: 'pentest evaluation protocol' },
        { title: 'Reference', url: '/docs/reference', content: 'glossary known issues roadmap' },
        { title: 'Glossary', url: '/docs/reference/glossary', content: 'terms definitions' },
        { title: 'Known Issues', url: '/docs/reference/known-issues', content: 'bugs workarounds' },
        { title: 'Roadmap', url: '/docs/reference/roadmap', content: 'future plans' },
        { title: 'Changelog', url: '/docs/reference/changelog', content: 'history changes' },
        { title: 'Literature', url: '/docs/reference/literature', content: 'academic technical references' },
        { title: 'Reference Hub', url: '/reference', content: 'quick reference glossary tables' },
      ];

      let matches = [];
      let selectedIndex = 0;

      function renderMatches() {
        if (matches.length === 0) {
          searchResults.innerHTML = '<div class="md-search-empty">No results found</div>';
          return;
        }
        searchResults.innerHTML = matches.map((m, i) => `
          <a href="${m.url}" class="md-search-result${i === selectedIndex ? ' selected' : ''}" data-index="${i}">
            <div class="title">${m.title}</div>
            <div class="path">${m.url}</div>
          </a>
        `).join('');
      }

      function runSearch(value) {
        const q = value.toLowerCase().trim();
        if (!q) {
          matches = [];
          searchResults.innerHTML = '<div class="md-search-empty">Type to search...</div>';
          return;
        }
        matches = pages.filter(p => p.title.toLowerCase().includes(q) || p.content.toLowerCase().includes(q));
        selectedIndex = 0;
        renderMatches();
      }

      searchInput?.addEventListener('input', (e) => runSearch(e.target.value));
      searchInput?.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          selectedIndex = Math.min(selectedIndex + 1, matches.length - 1);
          renderMatches();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          selectedIndex = Math.max(selectedIndex - 1, 0);
          renderMatches();
        } else if (e.key === 'Enter' && matches[selectedIndex]) {
          window.location.href = matches[selectedIndex].url;
        }
      });

      // TOC scroll spy
      const tocLinks = Array.from(document.querySelectorAll('#toc-nav a'));
      const headingFor = (link) => {
        const href = link.getAttribute('href');
        return href ? document.querySelector(href) : null;
      };
      const markCurrent = () => {
        let current = tocLinks[0] || null;
        for (const link of tocLinks) {
          const heading = headingFor(link);
          if (heading && heading.getBoundingClientRect().top <= 130) current = link;
        }
        tocLinks.forEach(link => link.classList.toggle('active', link === current));
      };
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => { markCurrent(); ticking = false; });
      }, { passive: true });
      markCurrent();
    </script>
  </body>
</html>
